{
  "expo": {
    "name": "AgroApp",
    "slug": "agroapp",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agroapp.elesfuerzo.prototipo"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.agroapp.elesfuerzo.prototipo",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.NFC"
      ]
    },
    "web": {
      "favicon": "./assets/logo.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F6F5EF"
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "Acerca el teléfono a la etiqueta del bovino para abrir su ficha."
        }
      ]
    ],
    "scheme": "agroapp",
    "experiments": {
      "typedRoutes": true
    }
  }
}
